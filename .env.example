# Для локального запуска скопируйте в .env.
#
# Обязательна ровно одна переменная — DATABASE_URL. Всё остальное настраивается
# на самом сайте («Настройки») и хранится в базе:
#   - токен GIRITON REST API
#   - ссылка на Google-таблицу с именами
#   - показатель, считающийся часами
#   - интервал автосинхронизации
#   - пароль (генерируется при первом запуске и печатается в лог)
#
# Переменные ниже — необязательные. Если задать, они ЖЁСТКО перекрывают настройку
# с сайта: поле станет недоступным для правки. Удобно, чтобы зафиксировать значение
# на проде, но для обычной работы не нужно.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vilgane

# ADMIN_PASSWORD=            # перекрывает пароль из базы, отключает смену пароля на сайте
# SESSION_SECRET=            # иначе генерируется сам и хранится в базе
# GIRITON_API_TOKEN=         # формат: vasefirma.xxxx-xxxx-xxxx-xxxx
# GIRITON_ACTIVITY=Práce (celkem)
# NAMES_SHEET_URL=           # ссылка «Поделиться» на таблицу со списком сотрудников
# SYNC_INTERVAL_MINUTES=60   # 0 — выключить автосинхронизацию
# CRON_SECRET=               # ключ для внешнего планировщика: GET /api/cron/sync?key=...

NODE_ENV=development
PORT=3000
