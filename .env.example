# Скопируйте в .env для локального запуска. На хостинге задайте те же переменные в панели.
# ФАЙЛ .env НЕ КОММИТИТСЯ — репозиторий публичный.

# Подключение к Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vilgane

# Пароль для входа на сайт (единственный администратор)
ADMIN_PASSWORD=

# Секрет для подписи сессионной куки. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Постоянный токен GIRITON REST API.
# Создаётся в GIRITON: Nastavení -> Sparovana zarizeni -> REST API token
# Формат: vasefirma.xxxx-xxxx-xxxx-xxxx
GIRITON_API_TOKEN=

# Показатель докладки, который считается «часами»
GIRITON_ACTIVITY=Práce (celkem)

# Как часто автоматически тянуть текущий месяц, в минутах (0 — выключить)
SYNC_INTERVAL_MINUTES=60

# Ключ для внешнего планировщика: GET /api/cron/sync?key=...
CRON_SECRET=

NODE_ENV=development
PORT=3000
